XAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
AI_API_KEY=
AI_GATEWAY_API_KEY=

# Optional: force a shard count instead of Discord's automatic recommendation
SHARD_COUNT=
